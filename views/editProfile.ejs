<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Edit profile' }) %>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900 antialiased">
    <%- include('partials/toast') %>
    <%- include('partials/navbar') %>

    <main class="flex flex-1 items-center justify-center px-4 py-16">
      <div class="w-full max-w-lg">
        <h1 class="mb-8 text-center text-2xl font-bold text-slate-900">Edit your profile</h1>

        <form action="/profile/edit" method="post" class="card space-y-4 p-6">
          <div>
            <label class="label" for="name">Name</label>
            <input
              class="field"
              type="text"
              id="name"
              name="name"
              autocomplete="name"
              value="<%= user.name %>"
              placeholder="name"
            />
          </div>
          <div>
            <label class="label" for="img">Avatar URL</label>
            <input
              class="field"
              type="text"
              id="img"
              name="img"
              value="<%= user.img %>"
              placeholder="https://example.com/avatar.jpg"
            />
          </div>
          <div>
            <label class="label" for="phone">Phone</label>
            <input
              class="field"
              type="tel"
              id="phone"
              name="phone"
              autocomplete="tel"
              value="<%= user.phone %>"
              placeholder="9876543210"
            />
          </div>
          <div class="flex gap-3 pt-2">
            <button type="submit" class="btn-primary flex-1">
              <i class="ri-save-line"></i> Save changes
            </button>
            <a href="/" class="btn-secondary flex-1">Cancel</a>
          </div>
        </form>
      </div>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
