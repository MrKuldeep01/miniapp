<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Error' }) %>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900 antialiased">
    <%- include('partials/toast') %>
    <%- include('partials/guestHeader') %>

    <main class="flex flex-1 items-center justify-center px-4 py-16">
      <div class="max-w-md text-center">
        <p class="text-sm font-semibold text-brand-600"><%= status %></p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          <%= heading %>
        </h1>
        <p class="mt-4 text-base text-slate-500"><%= message %></p>
        <div class="mt-8 flex items-center justify-center gap-3">
          <button
            type="button"
            onclick="history.back()"
            class="btn-secondary"
          >
            <i class="ri-arrow-left-line"></i> Go back
          </button>
          <a href="/" class="btn-primary">Go home</a>
        </div>
      </div>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
