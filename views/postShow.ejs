<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Posts' }) %>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900 antialiased">
    <%- include('partials/toast') %>
    <%- include('partials/navbar') %>

    <main class="flex-1">
      <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
        <div class="mb-10 flex items-center justify-between gap-4">
          <h1 class="text-3xl font-bold text-slate-900">Latest posts</h1>
          <a href="/post/create" class="btn-primary">
            <i class="ri-add-line"></i> New post
          </a>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% posts.slice().reverse().forEach((post) => {
               const isOwner = post.owner && post.owner._id.toString() === currentUserId;
               const isLiked = post.likes.some((id) => id.toString() === currentUserId);
          %>
          <article class="card flex flex-col overflow-hidden">
            <img
              class="h-48 w-full object-cover"
              src="<%= post.img %>"
              alt="<%= post.desc %>"
            />

            <div class="flex flex-1 flex-col p-4">
              <a href="/account/<%= post.owner._id %>" class="mb-2 flex items-center gap-2">
                <img
                  class="h-7 w-7 rounded-full object-cover"
                  src="<%= post.owner.img %>"
                  alt="<%= post.owner.name %>"
                />
                <span class="text-sm font-medium text-slate-700 hover:text-brand-600"><%= post.owner.name %></span>
                <span class="ml-auto text-xs text-slate-400">
                  <%= new Date(post.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                </span>
              </a>

              <p class="line-clamp-2 flex-1 text-sm text-slate-800"><%= post.desc %></p>

              <div class="mt-4 flex items-center gap-1 border-t border-slate-100 pt-3">
                <a
                  href="/post/like/<%= post._id %>"
                  class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-sm font-medium transition <%= isLiked ? 'text-brand-600 bg-brand-50' : 'text-slate-500 hover:bg-slate-100' %>"
                >
                  <i class="<%= isLiked ? 'ri-heart-fill' : 'ri-heart-line' %>"></i>
                  <%= post.likes.length %>
                </a>

                <% if (isOwner) { %>
                <a
                  href="/post/edit/<%= post._id %>"
                  class="ml-auto inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-sm font-medium text-slate-500 transition hover:bg-slate-100"
                >
                  <i class="ri-pencil-line"></i>
                </a>
                <a
                  href="/post/delete/<%= post._id %>"
                  onclick="return confirm('Delete this post? This can\'t be undone.')"
                  class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-sm font-medium text-slate-500 transition hover:bg-red-50 hover:text-red-600"
                >
                  <i class="ri-delete-bin-line"></i>
                </a>
                <% } %>
              </div>
            </div>
          </article>
          <% }) %>
        </div>
      </section>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
