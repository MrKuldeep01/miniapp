<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'New post' }) %>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900 antialiased">
    <%- include('partials/toast') %>
    <%- include('partials/navbar') %>

    <main class="flex flex-1 items-center justify-center px-4 py-16">
      <div class="w-full max-w-lg">
        <h1 class="mb-8 text-center text-2xl font-bold text-slate-900">Create a post</h1>

        <form action="/post/create" method="post" class="card space-y-4 p-6">
          <div>
            <label class="label" for="desc">Description</label>
            <input
              class="field"
              type="text"
              id="desc"
              name="desc"
              required
              placeholder="What's on your mind?"
            />
          </div>
          <div>
            <label class="label" for="img">Image URL</label>
            <input
              class="field"
              type="text"
              id="img"
              name="img"
              placeholder="https://example.com/photo.jpg"
            />
          </div>
          <div class="flex gap-3 pt-2">
            <button type="submit" class="btn-primary flex-1">
              <i class="ri-send-plane-line"></i> Post
            </button>
            <a href="/posts" class="btn-secondary flex-1">Cancel</a>
          </div>
        </form>
      </div>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
