<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Posts' }) %>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900 antialiased">
    <%- include('partials/toast') %>
    <%- include('partials/navbar') %>

    <main class="flex flex-1 items-center justify-center px-4 py-16">
      <div class="mx-auto max-w-md text-center">
        <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-brand-50">
          <i class="ri-gallery-line text-4xl text-brand-500"></i>
        </div>
        <h1 class="text-2xl font-bold text-slate-900">No posts yet</h1>
        <p class="mt-2 text-sm text-slate-500">Be the first to share something with everyone.</p>
        <a href="/post/create" class="btn-primary mt-6">
          <i class="ri-add-line"></i> Create your first post
        </a>
      </div>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
