<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: isOwner ? 'My profile' : user.name + "'s profile" }) %>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900 antialiased">
    <%- include('partials/toast') %>
    <%- include('partials/navbar') %>

    <main class="flex-1">
      <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
        <div class="card flex flex-col items-center gap-8 p-8 sm:flex-row sm:items-start">
          <img
            class="h-32 w-32 shrink-0 rounded-2xl object-cover ring-4 ring-brand-50"
            src="<%= user.img %>"
            alt="<%= user.name %>"
          />

          <div class="w-full text-center sm:text-left">
            <h1 class="text-3xl font-bold text-slate-900"><%= user.name %></h1>

            <dl class="mt-4 flex flex-col gap-2 text-sm text-slate-600 sm:flex-row sm:flex-wrap sm:gap-x-6 sm:gap-y-2">
              <div class="flex items-center justify-center gap-1.5 sm:justify-start">
                <i class="ri-mail-line text-slate-400"></i>
                <dt class="sr-only">Email</dt>
                <dd><%= user.email %></dd>
              </div>
              <% if (user.phone) { %>
              <div class="flex items-center justify-center gap-1.5 sm:justify-start">
                <i class="ri-phone-line text-slate-400"></i>
                <dt class="sr-only">Phone</dt>
                <dd><%= user.phone %></dd>
              </div>
              <% } %>
              <div class="flex items-center justify-center gap-1.5 sm:justify-start">
                <i class="ri-file-list-line text-slate-400"></i>
                <dt class="sr-only">Posts</dt>
                <dd><%= user.post.length %> post<%= user.post.length === 1 ? '' : 's' %></dd>
              </div>
            </dl>

            <% if (isOwner) { %>
            <a href="/profile/edit" class="btn-secondary mt-6">
              <i class="ri-user-settings-line"></i> Edit profile
            </a>
            <% } %>
          </div>
        </div>
      </section>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
